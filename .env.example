# Frontend environment configuration
# Base URL for the Jarvis backend FastAPI server (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# NOTE: GEMINI_API_KEY is a BACKEND-only environment variable.
# NEVER prefix it with VITE_, never expose it to client-side code,
# and never commit real API keys to version control.
# Set GEMINI_API_KEY on the backend server environment:
# export GEMINI_API_KEY="your-gemini-api-key"
